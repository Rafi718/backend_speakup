# Copy these into Dokploy's Environment settings for the service.
# APP_KEY must be generated once: `php artisan key:generate --show sdsd`

APP_NAME=SpeakUp
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.speakup.web.id
APP_HOST=api.speakup.web.id

LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=speakup-db
DB_PORT=3306
DB_DATABASE=speakup
DB_USERNAME=root
DB_PASSWORD=change-me

SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database

SANCTUM_STATEFUL_DOMAINS=api.speakup.web.id
CORS_ALLOWED_ORIGINS=https://api.speakup.web.id
FRONTEND_URL=https://api.speakup.web.id

MAIL_MAILER=log
MAIL_FROM_ADDRESS=noreply@speakup.local
MAIL_FROM_NAME=SpeakUp
