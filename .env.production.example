# ---------------------------------------------------------------------------
# Copy these into Dokploy's Environment settings for the service.
# APP_KEY dibawah sudah di-generate, aman untuk dipakai. Kalau mau rotate,
# jalankan di host manapun: php artisan key:generate --show
# ---------------------------------------------------------------------------

APP_NAME=SpeakUp
APP_ENV=production
APP_KEY=base64:drqZMsIk/nKViyXacAF/ZcbOTI9liMHXtBob5dDIDwA=
APP_DEBUG=false
APP_URL=https://api.speakup.web.id
APP_HOST=api.speakup.web.id

LOG_CHANNEL=stderr
LOG_LEVEL=info

# --- Database (internal Dokploy MySQL) ---
DB_CONNECTION=mysql
DB_HOST=speakup-speakup-pnnoho
DB_PORT=3306
DB_DATABASE=db_speakup
DB_USERNAME=mysql
DB_PASSWORD=2HgUQlOLW9wYOlvfegwe

# --- Session / Cache / Queue (database-backed) ---
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_DOMAIN=.speakup.web.id
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
CACHE_STORE=database
QUEUE_CONNECTION=database

# --- CORS / Sanctum / Frontend ---
SANCTUM_STATEFUL_DOMAINS=speakup.web.id,www.speakup.web.id
CORS_ALLOWED_ORIGINS=https://speakup.web.id,https://www.speakup.web.id
CORS_ALLOWED_ORIGINS_PATTERNS=
FRONTEND_URL=https://speakup.web.id

# --- Mail ---
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=
MAIL_FROM_ADDRESS=noreply@speakup.web.id
MAIL_FROM_NAME=SpeakUp

# --- Proxy trust (Traefik) ---
TRUSTED_PROXIES=*
