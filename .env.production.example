# ============================================
# SpeakUp Backend - Production Environment
# ============================================
# Copy this to .env:  cp .env.production.example .env
# Then edit the values below.
#
# APP_KEY must be generated after first build:
#   docker compose run --rm app php artisan key:generate --show

# --------------------------------------------------
# Application
# --------------------------------------------------
APP_NAME=SpeakUp
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.speakup.web.id
APP_DOMAIN=api.speakup.web.id

# --------------------------------------------------
# Logging
# --------------------------------------------------
LOG_CHANNEL=stderr
LOG_LEVEL=info

# --------------------------------------------------
# Database (MySQL in Docker)
# --------------------------------------------------
# DB_HOST should be the Docker service name "mysql"
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=db_speakup
DB_USERNAME=speakup_user
DB_PASSWORD=123456789

# MySQL root password (for backup/restore)
DB_ROOT_PASSWORD=123456789

# --------------------------------------------------
# Session & Cache
# --------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_DOMAIN=.speakup.web.id
CACHE_STORE=database
QUEUE_CONNECTION=database

# --------------------------------------------------
# Sanctum & CORS
# --------------------------------------------------
# Comma-separated list of frontend domains for "stateful" auth
SANCTUM_STATEFUL_DOMAINS=speakup.web.id,www.speakup.web.id

# Allowed CORS origins (your frontend URL)
CORS_ALLOWED_ORIGINS=https://speakup.web.id

# Frontend URL (used for password reset links, etc)
FRONTEND_URL=https://speakup.web.id

# --------------------------------------------------
# Mail (for password reset)
# --------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@speakup.web.id"
MAIL_FROM_NAME="${APP_NAME}"

# --------------------------------------------------
# Caddy / ACME (Let's Encrypt)
# --------------------------------------------------
ACME_EMAIL=admin@speakup.web.id

# --------------------------------------------------
# Migration
# --------------------------------------------------
# Set to "true" to skip migrations (use if restoring from backup)
SKIP_MIGRATION=false
