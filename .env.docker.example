# ============================================
# SpeakUp Backend - Production Environment
# ============================================
# Dipakai oleh backend/docker-compose.yml untuk deploy BE + MySQL di Dokploy.
# Copy ke .env lalu isi valuenya.

# Laravel App Key
# Generate dengan: docker compose run --rm backend php artisan key:generate --show
APP_KEY=base64:GENERATE_THIS_KEY

# URL publik backend
APP_URL=https://api.speakup.web.id

# Domain backend (dipakai Traefik)
BACKEND_HOST=api.speakup.web.id

# Database
DB_ROOT_PASSWORD=change_me_root
DB_DATABASE=db_speakup
DB_USERNAME=speakup
DB_PASSWORD=change_me_user

# Session & CORS - sesuaikan dengan domain FE
# SESSION_DOMAIN pakai leading dot agar cookie shared antar subdomain
SESSION_DOMAIN=.speakup.web.id
SANCTUM_STATEFUL_DOMAINS=speakup.web.id,www.speakup.web.id
CORS_ALLOWED_ORIGINS=https://speakup.web.id,https://www.speakup.web.id

# Mail (opsional, default log)
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@speakup.web.id
