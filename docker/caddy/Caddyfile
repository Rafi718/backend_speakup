{
	# Email for ACME (Let's Encrypt)
	email {$ACME_EMAIL:admin@speakup.web.id}

	# Auto HTTPS
	auto_https disable_redirects
}

# API domain
{$APP_DOMAIN:api.speakup.web.id} {
	# Root directory
	root * /var/www/html/public

	# Enable file server
	file_server

	# Trust reverse proxy headers (Dokploy/Traefik/Cloudflare)
	trusted_proxies private_ranges

	# Logging
	log {
		output stdout
		format json
	}

	# Encode responses
	encode gzip zstd

	# PHP-FPM
	php_fastcgi 127.0.0.1:9000 {
		# Resolve symlinks
		resolve_root_symlink

		# Environment variables for PHP
		env PHP_VALUE "upload_max_filesize=25M
post_max_size=25M
memory_limit=512M"
	}

	# Security headers
	header {
		# HSTS
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		# Prevent MIME sniffing
		X-Content-Type-Options "nosniff"
		# Clickjacking protection
		X-Frame-Options "DENY"
		# XSS protection
		X-XSS-Protection "1; mode=block"
		# Remove server header
		-Server
	}

	# Block access to sensitive files
	@blocked {
		path /.*
		not path /.well-known/*
	}
	respond @blocked 404

	# Health check endpoint
	respond /up 200

	# Handle OPTIONS requests for CORS
	@options method OPTIONS
	respond @options 204
}

# Redirect www to non-www
www.{$APP_DOMAIN:api.speakup.web.id} {
	redir https://{$APP_DOMAIN:api.speakup.web.id}{uri} permanent
}
